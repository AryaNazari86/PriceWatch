# Steel cloud browser API key — https://app.steel.dev/settings/api-keys
STEEL_API_KEY=your-steel-api-key-here

# LLM used to extract price/title/stock from arbitrary product pages.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Email notifications on any detected price change (up or down).
# Sign up free at https://resend.com, then create a key at
# https://resend.com/api-keys.
RESEND_API_KEY=your-resend-api-key-here
# Address that gets notified. No accounts in this app, so it's one global address.
NOTIFY_EMAIL=you@example.com

# --- Optional overrides (sensible defaults are used if omitted) ---

# Sender shown on notification emails. Defaults to Resend's shared sandbox
# sender, which works without verifying your own domain.
# RESEND_FROM_EMAIL=PriceWatch <onboarding@resend.dev>

# Model used for price extraction (fast + cheap is fine, it's a small JSON task)
# LLM_MODEL=claude-haiku-4-5

# How often the whole watchlist is auto-checked, in seconds (default: 86400 = 24h).
# Lower this for demos/testing, e.g. 120 for a 2-minute loop.
# CHECK_INTERVAL_SECONDS=86400

# Every product in the watchlist is checked in its own concurrent Steel
# session (no cap) — so these waits are paid once per batch, not once per
# product, and can be generous without slowing a check down proportionally.
# NETWORK_IDLE_TIMEOUT_MS=10000
# PAGE_SETTLE_MS=2500

# Host/port for the local server
# HOST=127.0.0.1
# PORT=8000
